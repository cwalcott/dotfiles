# Unix
alias tlf="tail -f"
alias ln='ln -v'
alias mkdir='mkdir -p'
alias ...='../..'
alias l='ls'
alias ll='ls -al'
alias lh='ls -Alh'
alias -g G='| grep'
alias -g M='| less'
alias -g L='| wc -l'
alias -g ONE="| awk '{ print \$1}'"

# ls
alias ls='eza'
alias ll='eza -l --git'
alias la='eza -la --git'

# tree
alias tree='eza --tree'

# git
alias gb='git branch'
alias gd='git diff'
alias gc='git commit -v'
alias gca='git commit -v -a'
alias gco='git checkout'
alias gd='git diff'
alias gs='git status'
alias gw='git worktree'

# Other
alias vi='nvim'
alias history='fc -l 1'

# Node.js
alias tn='node --import=tsx --env-file=.env'
alias m='npx mocha'

# Include custom aliases
[[ -f ~/.aliases.local ]] && source ~/.aliases.local
